configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "Iosevka 11";
    drun-display-format: "{name}";
    window-format: "{w}";
    matching: "fuzzy";
}

window {
    width: 25%;
    padding: 14px;
    border: 0px;
    border-radius: 0px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 8px;
}

inputbar {
    children: [ prompt, entry ];
    padding: 8px;
    border: 0px;
    border-radius: 0px;
    background-color: transparent;
}

prompt {
    padding: 0 8px 0 0;
}

entry {
    placeholder: "Search...";
}

listview {
    lines: 10;
    columns: 1;
    spacing: 2px;
    fixed-height: true;
    scrollbar: false;
}

element {
    padding: 7px 8px;
    border: 0px;
    border-radius: 0px;
    background-color: transparent;
}

element selected {
    background-color: transparent;
    text-color: #000000;
}

element-text {
    vertical-align: 0.5;
}

element selected element-text {
    text-color: #000000;
}

element-icon {
    size: 20px;
    margin: 0 8px 0 0;
}

@import "~/.cache/wal/colors-rofi-dark.rasi"

