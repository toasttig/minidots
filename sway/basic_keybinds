# floating window control rules
# -----------------------------
#
# drag floating windows by holding down $mod and left mouse button.
# resize them with right mouse button + $mod.
# despite the name, also works for non-floating windows.

# start a terminal. you can change the terminal in variables file.
bindsym $mod+return exec $term

# kill focused window.
bindsym $mod+q kill

# start your launcher.
bindsym $mod+d exec rofi -show drun
bindsym $mod+t exec ~/.local/bin/wallpaper-picker 
# take screenshot.
bindsym $mod+s exec $config_path/screenshot.sh
bindsym $mod+Ctrl+l exec $config_path/lock.sh
bindsym $mod+n exec swaync-client -t
# Floating Alacritty
bindsym $mod+Shift+Return exec alacritty --class floating-alacritty
# right mouse button for dragging.
floating_modifier $mod normal

# reload the configuration file.
bindsym $mod+c reload

# exit sway (logs you out of your wayland session).
bindsym $mod+m exec swaymsg exit
